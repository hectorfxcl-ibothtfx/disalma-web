---
import Layout from '../../layouts/Layout.astro';
import CatalogIsland from '../../components/catalog/CatalogIsland';
import { categories } from '../../data/categories';
import { products, getProductsByCategory } from '../../data/products';

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat }
  }));
}

const { category } = Astro.props;
const categoryProducts = getProductsByCategory(category.id);

const categoryJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category.name} | Liquidadora Disalma.cl`,
  description: category.description,
  url: `https://disalma.cl/categorias/${category.slug}`,
  numberOfItems: categoryProducts.length
};
---

<Layout
  title={`${category.name} en Bidón 5L y Formatos Ahorro | Disalma.cl`}
  description={category.description}
  jsonLd={categoryJsonLd}
>
  {/* Category Header */}
  <div class="bg-slate-900 text-white py-12 border-b border-slate-800">
    <div class="max-w-site space-y-4">
      {/* Breadcrumbs */}
      <nav class="flex items-center gap-2 text-xs text-slate-400">
        <a href="/" class="hover:text-amber-400">Inicio</a>
        <span>/</span>
        <a href="/catalogo" class="hover:text-amber-400">Catálogo</a>
        <span>/</span>
        <span class="text-amber-400 font-bold">{category.name}</span>
      </nav>

      <div class="space-y-2">
        <span class="inline-block bg-amber-400 text-slate-950 font-black text-xs px-2.5 py-0.5 rounded uppercase">
          Categoría Especializada
        </span>
        <h1 class="text-3xl sm:text-4xl font-black text-white">
          {category.name}
        </h1>
        <p class="text-xs sm:text-sm text-slate-300 max-w-2xl leading-relaxed">
          {category.description}
        </p>
      </div>
    </div>
  </div>

  {/* Category Catalog Island */}
  <div class="max-w-site py-10">
    <CatalogIsland
      client:load
      initialProducts={products}
      categories={categories}
      initialCategorySlug={category.id}
    />
  </div>
</Layout>
