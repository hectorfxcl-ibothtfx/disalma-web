---
import Layout from '../../layouts/Layout.astro';
import { blogPosts, type BlogPost } from '../../data/blogPosts';
import { businessInfo } from '../../data/business';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://liquialma.cl/blog/${post.slug}`
  },
  headline: post.title,
  description: post.description,
  image: `https://liquialma.cl${post.image}`,
  datePublished: post.publishedAt,
  dateModified: post.publishedAt,
  author: {
    '@type': 'Organization',
    name: 'LiquiAlma - Liquidadora Alma Janette Curicó',
    url: 'https://liquialma.cl'
  },
  publisher: {
    '@type': 'Organization',
    name: 'LiquiAlma',
    logo: {
      '@type': 'ImageObject',
      url: 'https://liquialma.cl/images/logo.png'
    }
  },
  keywords: post.keywords.join(', ')
};
---

<Layout
  title={`${post.title} | LiquiAlma.cl Curicó`}
  description={post.description}
  jsonLd={articleJsonLd}
>
  <article style="max-width:800px;margin:0 auto;padding:2.5rem 1rem 5rem;">
    {/* Breadcrumbs */}
    <nav style="display:flex;align-items:center;gap:.5rem;font-size:.8rem;color:#64748B;margin-bottom:1.5rem;">
      <a href="/" style="color:#64748B;text-decoration:none;">Inicio</a>
      <span>/</span>
      <a href="/blog" style="color:#64748B;text-decoration:none;">Blog</a>
      <span>/</span>
      <span style="color:#0F172A;font-weight:700;">{post.category}</span>
    </nav>

    <header style="margin-bottom:2rem;">
      <span style="background:#FEF3C7;color:#92400E;padding:.25rem .75rem;border-radius:999px;font-size:.75rem;font-weight:800;display:inline-block;margin-bottom:.75rem;">
        {post.category}
      </span>
      <h1 style="font-size:2.2rem;font-weight:900;color:#0F172A;line-height:1.25;margin:0 0 1rem;">
        {post.title}
      </h1>
      <div style="display:flex;gap:1rem;color:#64748B;font-size:.85rem;font-weight:600;">
        <span>📅 Publicado el {post.publishedAt}</span>
        <span>⏱️ {post.readTime}</span>
        <span>📍 Curicó, Chile</span>
      </div>
    </header>

    <div
      style="font-size:1.05rem;line-height:1.8;color:#334155;"
      set:html={post.content}
    />

    {/* CTA Card Local */}
    <div style="margin-top:3.5rem;background:#0F172A;border-radius:1.25rem;padding:2rem;color:white;text-align:center;">
      <span style="font-size:2rem;margin-bottom:.5rem;display:inline-block;">🧺</span>
      <h3 style="font-size:1.4rem;font-weight:900;color:white;margin:0 0 .5rem;">
        ¿Buscas útiles de aseo o perfumería con precio liquidadora en Curicó?
      </h3>
      <p style="color:#94A3B8;max-width:550px;margin:0 auto 1.5rem;font-size:.95rem;">
        En LiquiAlma.cl puedes armar tu pedido online y recibirlo directo en tu domicilio en Curicó o retirar en nuestro local en Camino a Tutuquén #1500 Local 7.
      </p>
      <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;">
        <a
          href="/catalogo"
          style="background:#F59E0B;color:#000;padding:.75rem 1.5rem;border-radius:.75rem;font-weight:800;text-decoration:none;"
        >
          Ver Catálogo Completo
        </a>
        <a
          href={`https://wa.me/${businessInfo.whatsappNumber}?text=${encodeURIComponent('Hola LiquiAlma! Leí su artículo en el blog y quiero cotizar productos de aseo.')}`}
          target="_blank"
          rel="noopener noreferrer"
          style="background:#22C55E;color:white;padding:.75rem 1.5rem;border-radius:.75rem;font-weight:800;text-decoration:none;"
        >
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </article>
</Layout>
