---
import Layout from '../layouts/Layout.astro';
import { products, getFeaturedProducts } from '../data/products';
import { categories } from '../data/categories';
import { testimonials } from '../data/testimonials';
import { businessInfo } from '../data/business';
import { formatCLP, calculateDiscount } from '../utils/formatters';
import AddToCartButton from '../components/product/AddToCartButton';

const featuredProducts = getFeaturedProducts();

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: `${businessInfo.name} - ${businessInfo.legalName}`,
  description: 'Distribuidora mayorista y minorista de útiles de aseo, detergentes en bidón de 5L y productos de limpieza para el hogar y empresas.',
  url: 'https://disalma.cl',
  telephone: businessInfo.phoneRaw,
  address: {
    '@type': 'PostalAddress',
    streetAddress: businessInfo.address,
    addressLocality: businessInfo.city,
    addressRegion: businessInfo.region,
    addressCountry: 'CL'
  },
  priceRange: '$$'
};

const iconMap: Record<string, string> = {
  'aseo-ropa': '👕',
  'aseo-cocina': '🍳',
  'aseo-bano': '✨',
  'aseo-general': '🏠',
};
---

<Layout
  title="Disalma.cl | Liquidadora Alma Janette • Útiles de Aseo al Por Mayor"
  description="Ahorra hasta un 45% en detergentes 5L, lavalozas, cloro gel y desengrasantes. Pide online y coordina tu despacho directo por WhatsApp."
  jsonLd={homeJsonLd}
>

  <!-- ══════════════════════════════════
       HERO
  ══════════════════════════════════ -->
  <section class="hero">
    <div class="wrap">
      <div class="hero__grid">

        <!-- Texto principal -->
        <div>
          <div class="hero__tag" style="margin-bottom:1.25rem;">
            <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:#DC2626;" class="pulse"></span>
            Liquidadora Alma Janette · Santiago
          </div>

          <h1 class="hero__title" style="margin-bottom:1rem;">
            Útiles de Aseo a<br class="d-none-xs"/>
            <span class="accent"> Precios de Distribuidora</span>
          </h1>

          <p class="hero__desc" style="margin-bottom:1.5rem;">
            Detergentes líquidos en bidones de <strong>5 Litros</strong>, desengrasantes, lavalozas y más.
            Arma tu pedido online y coordina el despacho directo por WhatsApp.
          </p>

          <div class="hero__ctas" style="margin-bottom:1.5rem;">
            <a href="/catalogo" class="btn btn-primary btn-lg" style="flex:1;max-width:280px;">
              Ver Catálogo Completo
              <span style="color:var(--yellow);">→</span>
            </a>
            <a
              href={`https://wa.me/${businessInfo.whatsappNumber}?text=${encodeURIComponent('Hola! Quiero hacer un pedido en Liquidadora Alma Janette.')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp btn-lg"
              style="flex:1;max-width:280px;"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
              </svg>
              Pedir por WhatsApp
            </a>
          </div>

          <!-- Trust bullets -->
          <div class="hero__trust">
            <div class="trust-item">
              <strong>Ahorra 45%</strong>
              <span>vs supermercados</span>
            </div>
            <div class="trust-item">
              <strong>Bidones 5L</strong>
              <span>Mayor rendimiento</span>
            </div>
            <div class="trust-item">
              <strong>Despacho Stgo</strong>
              <span>o retiro San Miguel</span>
            </div>
          </div>
        </div>

        <!-- Card del producto estrella -->
        <div>
          <div class="hero__card">
            <div class="hero__card-badge">🔥 MÁS VENDIDO</div>

            <div style="text-align:center;margin-bottom:1rem;">
              <span class="badge badge-yellow" style="font-size:.7rem;">Aseo de Ropa · Bidón 5L</span>
            </div>

            <div class="hero__card-image">
              <img
                src="/images/products/detergente-hipoalergenico-5l.webp"
                alt="Detergente Hipoalergénico 5 Litros"
                width="180"
                height="180"
                loading="eager"
              />
            </div>

            <h3 style="font-size:1rem;font-weight:800;color:var(--black);margin:.875rem 0 .375rem;text-align:center;line-height:1.3;">
              Detergente Líquido Hipoalergénico 5L
            </h3>

            <div style="display:flex;align-items:center;justify-content:center;gap:.625rem;flex-wrap:wrap;margin-bottom:.75rem;">
              <span style="font-size:.8125rem;color:var(--light);text-decoration:line-through;">{formatCLP(11490)}</span>
              <span style="font-size:1.625rem;font-weight:900;color:var(--black);line-height:1;">{formatCLP(6990)}</span>
              <span class="badge badge-savings">-39%</span>
            </div>

            <p style="font-size:.8125rem;color:var(--mid);text-align:center;margin-bottom:1rem;line-height:1.5;">
              Rinde más de 100 lavados. Cuida pieles sensibles y bebés.
            </p>

            <AddToCartButton
              client:load
              product={products[0]}
              variant="detail"
            />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       CATEGORÍAS
  ══════════════════════════════════ -->
  <section class="section section-alt" style="border-bottom:1px solid var(--border);">
    <div class="wrap">

      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:1.5rem;flex-wrap:wrap;">
        <div>
          <p class="txt-xs" style="color:var(--yellow-dark);text-transform:uppercase;letter-spacing:.06em;margin-bottom:.35rem;">Catálogo Organizado</p>
          <h2 class="txt-h2">Categorías de Limpieza</h2>
        </div>
        <a href="/catalogo" style="font-size:.875rem;font-weight:800;color:var(--yellow-dark);display:inline-flex;align-items:center;gap:.35rem;white-space:nowrap;">
          Ver todos los productos →
        </a>
      </div>

      <div class="grid-4">
        {categories.map((cat) => (
          <a href={`/categorias/${cat.slug}`} class="cat-card">
            <div class="cat-card__icon">{iconMap[cat.id] ?? '🧴'}</div>
            <div>
              <div class="cat-card__name">{cat.name}</div>
              <div class="cat-card__desc">{cat.shortDescription}</div>
            </div>
            <div class="cat-card__meta">
              <span class="cat-card__count">{cat.itemCount} productos</span>
              <span class="cat-card__arrow">→</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════
       PRODUCTOS DESTACADOS
  ══════════════════════════════════ -->
  <section class="section" style="border-bottom:1px solid var(--border);">
    <div class="wrap">

      <div class="section-header">
        <p class="eyebrow">Liquidación y Rendimiento</p>
        <h2 class="txt-h2">Más vendidos de la semana</h2>
        <p>Los favoritos de familias, negocios y comunidades en Santiago.</p>
      </div>

      <div class="grid-products">
        {featuredProducts.slice(0, 4).map((product) => {
          const discount = calculateDiscount(product.price, product.regularPrice);
          return (
            <div class="card product-card">
              <a href={`/productos/${product.slug}`} class="product-card__image">
                <div class="product-card__badges">
                  {discount > 0 && (
                    <span class="badge badge-red" style="font-size:.625rem;">-{discount}%</span>
                  )}
                  <span class="badge" style="background:rgba(15,23,42,.8);color:white;font-size:.625rem;">{product.format}</span>
                </div>
                <img
                  src={product.image}
                  alt={product.title}
                  loading="lazy"
                  width="240"
                  height="240"
                />
              </a>

              <div class="product-card__body">
                <span class="product-card__category">{product.categoryName}</span>
                <a href={`/productos/${product.slug}`} class="product-card__title">{product.title}</a>
                <span class="product-card__format">{product.format}</span>
                <p class="product-card__desc">{product.shortDescription}</p>
              </div>

              <div class="product-card__footer">
                <div class="product-card__price">
                  <span class="price-current">{formatCLP(product.price)}</span>
                  {product.regularPrice > product.price && (
                    <span class="price-original">{formatCLP(product.regularPrice)}</span>
                  )}
                </div>
                <AddToCartButton client:load product={product} variant="quick" />
              </div>
            </div>
          );
        })}
      </div>

      <div style="text-align:center;margin-top:2rem;">
        <a href="/catalogo" class="btn btn-primary btn-lg">
          Ver todos los {products.length} productos
          <span style="color:var(--yellow);">→</span>
        </a>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════
       POR QUÉ ELEGIRNOS
  ══════════════════════════════════ -->
  <section class="section section-alt" style="border-bottom:1px solid var(--border);">
    <div class="wrap">

      <div class="section-header">
        <p class="eyebrow">Nuestra Promesa</p>
        <h2 class="txt-h2">¿Por qué comprar en Disalma?</h2>
      </div>

      <div class="grid-4">
        <div class="why-card">
          <div class="why-card__icon" style="background:var(--yellow-light);">💰</div>
          <h3>Precios Directos</h3>
          <p>Sin intermediarios. Compras a precios mayoristas incluso si compras por unidad en bidones de 5L.</p>
        </div>
        <div class="why-card">
          <div class="why-card__icon" style="background:#FEE2E2;">⚖️</div>
          <h3>Calidad Concentrada</h3>
          <p>Fórmulas activas no rebajadas con agua. Cada gota rinde el doble en lavadoras, pisos y loza.</p>
        </div>
        <div class="why-card">
          <div class="why-card__icon" style="background:#DCFCE7;">💬</div>
          <h3>Atención por WhatsApp</h3>
          <p>Sin bots. Te atiende directamente el equipo de Alma Janette para coordinar entrega y pago.</p>
        </div>
        <div class="why-card">
          <div class="why-card__icon" style="background:#F1F5F9;">🚚</div>
          <h3>Despacho o Retiro</h3>
          <p>Entregas en Santiago o retiro sin costo en nuestro local de Gran Avenida (San Miguel).</p>
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════
       CÓMO PEDIR (3 PASOS)
  ══════════════════════════════════ -->
  <section class="section section-dark">
    <div class="wrap">

      <div class="section-header">
        <p class="eyebrow" style="color:var(--yellow);">Simple y Sin Enredos</p>
        <h2 class="txt-h2" style="color:var(--white);">Cómo hacer tu pedido en 3 pasos</h2>
        <p style="color:rgba(255,255,255,.6);">No necesitas registrarte ni ingresar datos de tarjeta en la web.</p>
      </div>

      <div class="grid-3">
        <div class="step">
          <div class="step__num">01</div>
          <h3>Arma tu Carrito</h3>
          <p>Navega por el catálogo, filtra por categoría y agrega los productos que necesitas.</p>
        </div>
        <div class="step">
          <div class="step__num">02</div>
          <h3>Indica Entrega y Pago</h3>
          <p>Ingresa tu nombre, comuna y elige entre despacho o retiro, y el método de pago.</p>
        </div>
        <div class="step">
          <div class="step__num" style="color:var(--whatsapp);">03</div>
          <h3>Envía a WhatsApp</h3>
          <p>Con un clic se abre WhatsApp con el detalle de tu pedido. Te confirmamos al instante.</p>
        </div>
      </div>

      <div style="text-align:center;margin-top:2.5rem;">
        <a href="/catalogo" class="btn btn-yellow btn-lg">
          Empezar a pedir ahora →
        </a>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════
       TESTIMONIOS
  ══════════════════════════════════ -->
  <section class="section section-alt" style="border-bottom:1px solid var(--border);">
    <div class="wrap">

      <div class="section-header">
        <p class="eyebrow">Clientes Satisfechos</p>
        <h2 class="txt-h2">Lo que dicen quienes ya ahorran con Disalma</h2>
      </div>

      <div class="grid-4">
        {testimonials.map((t) => (
          <div class="testimonial">
            <div class="testimonial__stars">{'★'.repeat(t.rating)}</div>
            <p class="testimonial__text">"{t.comment}"</p>
            <div class="testimonial__author">
              <strong>{t.name}</strong>
              <span>{t.role}</span>
              <span style="font-size:.6875rem;color:var(--yellow-dark);font-weight:700;">{t.location}</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════
       CTA FINAL
  ══════════════════════════════════ -->
  <section class="section" style="background:var(--yellow);">
    <div class="wrap">
      <div class="cta-banner">
        <span class="badge badge-yellow" style="margin-bottom:.5rem;">Atención Inmediata</span>
        <h2 class="txt-h2">¿Cotización para empresa o condominio?</h2>
        <p class="txt-body" style="color:rgba(255,255,255,.7);max-width:480px;margin-inline:auto;margin-top:.625rem;margin-bottom:1.75rem;">
          Escríbenos directo a WhatsApp. Te respondemos en minutos con stock disponible y precios por volumen.
        </p>
        <div style="display:flex;flex-direction:column;gap:.75rem;align-items:center;">
          <a
            href={`https://wa.me/${businessInfo.whatsappNumber}?text=${encodeURIComponent('Hola Disalma! Quiero cotizar productos de limpieza por mayor:')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp btn-lg"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            Conversar por WhatsApp ({businessInfo.phoneDisplay})
          </a>
          <a href="/catalogo" class="btn btn-outline" style="border-color:rgba(255,255,255,.4);color:white;">
            Ver el Catálogo Completo
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
