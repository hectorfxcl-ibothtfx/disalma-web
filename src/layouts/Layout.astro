---
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import GlobalCartContainer from '../components/cart/GlobalCartContainer';
import { businessInfo } from '../data/business';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  jsonLd?: Record<string, any>;
  currentPath?: string;
  noIndex?: boolean;
}

const {
  title = 'LiquiAlma.cl | Liquidadora de Útiles de Aseo y Limpieza al Por Mayor y Menor en Curicó',
  description = 'Liquidadora Alma Janette (LiquiAlma.cl) en Curicó. Ahorra hasta 45% en detergentes 5L, perfumería, aseo personal, suavizantes y desengrasantes. Despacho a domicilio en Curicó y retiro en Camino a Tutuquén #1500 Local 7.',
  image = 'https://liquialma.cl/images/og-liquialma.webp',
  type = 'website',
  jsonLd,
  currentPath = Astro.url.pathname,
  noIndex = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://liquialma.cl');

// Base LocalBusiness Schema for SEO
const defaultBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['WholesaleStore', 'Store'],
  name: `${businessInfo.name} - ${businessInfo.legalName}`,
  alternateName: ['LiquiAlma', 'Liquidadora Alma Janette Curicó', 'LiquiAlma Curicó'],
  url: 'https://liquialma.cl',
  logo: 'https://liquialma.cl/images/logo.png',
  image: image,
  description: description,
  telephone: businessInfo.phoneRaw,
  email: businessInfo.email,
  priceRange: '$$',
  paymentAccepted: 'Cash, Credit Card, Debit Card, Transfer',
  currenciesAccepted: 'CLP',
  address: {
    '@type': 'PostalAddress',
    streetAddress: businessInfo.address,
    addressLocality: businessInfo.city,
    addressRegion: businessInfo.region,
    postalCode: '3340000',
    addressCountry: 'CL'
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -34.9828,
    longitude: -71.2394
  },
  areaServed: [
    {
      '@type': 'City',
      name: 'Curicó'
    },
    {
      '@type': 'AdministrativeArea',
      name: 'Región del Maule'
    }
  ],
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '13:00',
      closes: '21:00'
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday'],
      opens: '11:00',
      closes: '19:00'
    }
  ]
};

const structuredData = jsonLd ? jsonLd : defaultBusinessSchema;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {/* Primary SEO Meta Tags */}
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="geo.region" content="CL-ML" />
    <meta name="geo.placename" content="Curicó" />
    <meta name="geo.position" content="-34.9828;-71.2394" />
    <meta name="ICBM" content="-34.9828, -71.2394" />

    {/* Open Graph / Facebook */}
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="LiquiAlma.cl" />
    <meta property="og:locale" content="es_CL" />

    {/* Twitter */}
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    {/* Structured Data JSON-LD */}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <Header currentPath={currentPath} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />

    {/* React Cart Island: Slide-over Drawer, Floating Button, Checkout Modal */}
    <GlobalCartContainer client:load />
  </body>
</html>
