---
interface Props {
  variant?: 'light' | 'dark';
  size?: 'sm' | 'md' | 'lg';
}

const { variant = 'dark', size = 'md' } = Astro.props;

const iconSize = size === 'sm' ? '36' : size === 'lg' ? '52' : '42';
const lightMode = variant === 'light';
---

<a href="/" class={`logo${lightMode ? ' logo--light' : ''}`} aria-label="Disalma - Liquidadora Alma Janette">
  <div class="logo__icon" style={`width:${iconSize}px;height:${iconSize}px;`}>
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" width="70%" height="70%">
      <!-- Balance Pole and Base -->
      <path d="M24 6V38" stroke="#0F172A" stroke-width="3" stroke-linecap="round"/>
      <path d="M16 40H32" stroke="#0F172A" stroke-width="3.5" stroke-linecap="round"/>
      <circle cx="24" cy="7" r="3" fill="#DC2626"/>
      <!-- Balance Crossbar -->
      <path d="M10 16L24 13L38 16" stroke="#0F172A" stroke-width="2.5" stroke-linecap="round"/>
      <!-- Left Pan strings -->
      <line x1="10" y1="16" x2="6" y2="25" stroke="#0F172A" stroke-width="1.5"/>
      <line x1="10" y1="16" x2="14" y2="25" stroke="#0F172A" stroke-width="1.5"/>
      <!-- Bottle left -->
      <rect x="5" y="25" width="10" height="12" rx="2" fill="#DC2626"/>
      <rect x="7" y="22" width="4" height="3" rx="1" fill="white"/>
      <!-- Right pan strings -->
      <line x1="38" y1="16" x2="34" y2="25" stroke="#0F172A" stroke-width="1.5"/>
      <line x1="38" y1="16" x2="42" y2="25" stroke="#0F172A" stroke-width="1.5"/>
      <!-- Spray right -->
      <rect x="34" y="27" width="8" height="10" rx="1.5" fill="#0F172A"/>
      <path d="M38 27V23H35L33 21" stroke="#0F172A" stroke-width="2" stroke-linecap="round"/>
      <!-- Star -->
      <path d="M24 18L25 21L28 22L25 23L24 26L23 23L20 22L23 21L24 18Z" fill="#DC2626"/>
    </svg>
  </div>

  <div class="logo__text">
    <div class="logo__brand">
      <strong>DISALMA</strong>
      <span class="badge badge-red" style="font-size:.55rem;padding:.2rem .5rem;">Liquidadora</span>
    </div>
    <span class="logo__sub">Alma Janette • Útiles de Aseo</span>
  </div>
</a>
